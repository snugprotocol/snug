{
  "name": "snug-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "check-dev": "node --test scripts/dev.test.mjs",
    "check-public-scrub": "node --test scripts/check-public-scrub.test.mjs && node scripts/check-public-scrub.mjs",
    "_comment-check-public-scrub": "LOCAL ONLY (gitignored, owner decision 2026-08-24) \u2014 deliberately NOT in `test`: the script is absent from a public clone, so wiring it into the root gate would fail every contributor. Run by hand before a flip or release.",
    "test": "turbo run test && pnpm run check-threat-model && pnpm run check-sandbox-guard && pnpm run check-gate-local && pnpm run check-release-desktop && pnpm run check-release-helper && pnpm run check-helper-pin && pnpm run check-website-sync && pnpm run check-dev && pnpm run check-deploy-web && pnpm run check-deploy-relay",
    "lint": "turbo run lint",
    "smoke": "pnpm --filter server build >/dev/null && pnpm --filter server smoke",
    "update-code-map": "node --test scripts/update-code-map-counts.test.mjs && node scripts/update-code-map-counts.mjs",
    "check-whitepaper": "node scripts/check-whitepaper.mjs",
    "check-threat-model": "node --test scripts/check-threat-model.test.mjs && node scripts/check-threat-model.mjs",
    "check-sandbox-guard": "node --test scripts/check-sandbox-guard.test.mjs",
    "check-gate-local": "node --test scripts/gate-local.test.mjs",
    "gate:local": "node scripts/gate-local.mjs",
    "check-release-desktop": "node --test scripts/release-desktop.test.mjs",
    "check-release-helper": "node --test scripts/release-helper.test.mjs && node --test apps/whatsapp-sidecar/pack-helper.node-test.mjs",
    "check-helper-pin": "node scripts/check-helper-pin.mjs",
    "check-website-sync": "node --test scripts/check-website-sync.test.mjs && node scripts/check-website-sync.mjs",
    "check-deploy-web": "node --test scripts/deploy-web.test.mjs",
    "check-deploy-relay": "node --test scripts/deploy-relay.test.mjs",
    "audit:deps": "node --test scripts/audit-deps.test.mjs && node scripts/audit-deps.mjs"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "^3.3.18"
    }
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "wrangler": "^4"
  }
}
