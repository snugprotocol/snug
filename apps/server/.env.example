# Snug reference server — environment template.
#
# Copy to `.env.local` and fill in real values:
#     cp apps/server/.env.example apps/server/.env.local
#
# `.env.local` is gitignored (`.env.*` in .gitignore). Never commit real keys.
# Secrets are read ONLY here, by apps/server/src/config.ts (hard constraint C5) —
# packages never read env, and adapters receive keys through config at boot.
#
# Loading: the server does NOT bundle dotenv. Node 22+ reads this natively:
#     node --env-file=.env.local dist/server.js
# (see `pnpm --filter server dev:local`)

# --- Which brain answers ------------------------------------------------
# mock | anthropic | openai
# `mock` is the offline demo brain — no key, no network, no cost.
# Boot fails fast if you pick a provider without its key below.
SNUG_ADAPTER=mock

# --- Provider keys ------------------------------------------------------
# Only the key matching SNUG_ADAPTER is required; comment out the other.
#
# IMPORTANT — comment optional vars out rather than leaving them empty.
# config.ts treats '' as unset (2026-08-02 lesson), so a bare `SNUG_MODEL=`
# selects the default rather than the empty string — but commented-out is
# still the convention: it reads as "unset" without needing that rule.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional model override. Commented out = the adapter's own default.
# Anthropic examples: claude-fable-5 | claude-opus-5 | claude-sonnet-5
# OpenAI example:     gpt-4o
# SNUG_MODEL=

# --- Where it listens ---------------------------------------------------
# The playground's Vite dev proxy hardcodes 127.0.0.1:8787 (apps/playground/
# vite.config.ts). Changing these means updating that proxy too.
PORT=8787
HOST=127.0.0.1

# --- Storage ------------------------------------------------------------
# SQLite directory, resolved relative to the process working directory.
# Run via `pnpm --filter server ...` and this lands at apps/server/data/.
SNUG_DATA_DIR=./data

# --- Hub SSO (Google OIDC) — all optional, all commented out ------------
# Leave everything below commented out for the single-user v1 behavior
# (no /auth/*, no /userdb, no cookies). Setting SNUG_AUTH=google turns the
# server into a multi-tenant hub and FAILS THE BOOT unless SNUG_SESSION_SECRET,
# SNUG_GOOGLE_CLIENT_ID, SNUG_GOOGLE_CLIENT_SECRET, and an explicit
# SNUG_CORS_ORIGIN are all set (fail closed — no reflect-any CORS with cookies).
#
# Enable Google sign-in ("google" is the only supported value).
# SNUG_AUTH=google
# HMAC key for session/CSRF/login-state cookies; >=32 chars of real randomness
# (e.g. `openssl rand -hex 32`). Rotating it logs every user out.
# SNUG_SESSION_SECRET=
# OAuth 2.0 Web application credentials from Google Cloud Console; add
# <origin>/auth/callback to the authorized redirect URIs.
# SNUG_GOOGLE_CLIENT_ID=
# SNUG_GOOGLE_CLIENT_SECRET=
# OIDC issuer override — tests point this at a local fake issuer. Commented
# out = https://accounts.google.com.
# SNUG_OIDC_ISSUER=
# Built playground directory served at / (SPA fallback; API routes win).
# Commented out = ../playground/dist relative to this app; skipped if absent.
# SNUG_STATIC_DIR=

# --- Tuning (rarely needed locally) -------------------------------------
# CORS is unnecessary in dev: the Vite proxy makes /invoke and /artifacts
# same-origin. Commented out = reflect any origin (auth disabled only);
# REQUIRED as an explicit origin when SNUG_AUTH=google.
# SNUG_CORS_ORIGIN=
# SSE heartbeat interval, ms.
SNUG_HEARTBEAT_MS=15000
# Per-IP token bucket. A simple cap, not authentication.
SNUG_RATE_CAPACITY=60
SNUG_RATE_REFILL_PER_SECOND=1
