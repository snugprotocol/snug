---
// MarketingLayout.astro — shared shell for the marketing pages (/, /download):
// dark-committed brand surface, sticky nav, footer. The docs hub has its own shell
// (Starlight); both draw from the same tokens.
import { site, siteMode } from '../config/site';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/videos/poster-landscape.jpg" />
  </head>
  <body class="site">
    {
      siteMode === 'local' && (
        <div class="local-banner" role="status">
          local E2E mode — playground → {site.playground}, download → staged DMG
        </div>
      )
    }
    <header class="nav-wrap">
      <nav class="container nav" aria-label="Main">
        <a class="brand" href="/">
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" class="brand-mark">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M10 2h12a8 8 0 0 1 8 8v12a8 8 0 0 1-8 8H10a8 8 0 0 1-8-8V10a8 8 0 0 1 8-8zm6 9a5 5 0 0 0-5 5v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6a5 5 0 0 0-5-5z"
            ></path>
          </svg>
          <span class="brand-word display">snug.</span>
        </a>
        <div class="nav-links">
          <a href="/docs/">Docs</a>
          <a href="/docs/spec/">Spec</a>
          <a href={site.playground} rel="noopener">Playground</a>
          <a href={site.githubOrg} rel="noopener" aria-label="GitHub" class="nav-gh">
            <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
          <a href="/download/" class="btn btn-primary nav-cta">Download</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" class="brand-mark">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M10 2h12a8 8 0 0 1 8 8v12a8 8 0 0 1-8 8H10a8 8 0 0 1-8-8V10a8 8 0 0 1 8-8zm6 9a5 5 0 0 0-5 5v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6a5 5 0 0 0-5-5z"
            ></path>
          </svg>
          <p class="muted">
            The Snug Protocol — an open protocol for agent-backed personal software. MIT licensed.
          </p>
        </div>
        <nav aria-label="Product">
          <h3>Product</h3>
          <a href={site.playground} rel="noopener">Playground</a>
          <a href="/download/">Desktop app</a>
          <a href="/docs/">Documentation</a>
        </nav>
        <nav aria-label="Protocol">
          <h3>Protocol</h3>
          <a href="/docs/spec/">Specification</a>
          <a href="/docs/spec/schemas/">Schemas</a>
          <a href="/docs/whitepaper/">Whitepaper</a>
        </nav>
        <nav aria-label="Community">
          <h3>Community</h3>
          <a href={site.githubOrg} rel="noopener">GitHub org</a>
          <a href={site.githubRepo} rel="noopener">Reference implementation</a>
          <a href={site.specRepo} rel="noopener">Spec repository</a>
          <a href={`mailto:${site.securityEmail}`}>{site.securityEmail}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .local-banner {
    background: var(--warn);
    color: #1d1207;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: center;
    padding: 0.35rem var(--space-4);
  }

  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--bg-deep) 78%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--fg);
  }

  .brand-mark {
    color: var(--ember);
    flex-shrink: 0;
  }

  .brand-word {
    font-size: 1.45rem;
    color: var(--fg);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
  }

  .nav-links > a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-s);
    font-weight: 500;
    transition: color var(--dur-1) var(--ease-out);
  }

  .nav-links > a:hover {
    color: var(--fg);
  }

  .nav-gh {
    display: inline-flex;
  }

  /* .nav-links > a (0,1,1) outweighs the global .btn-primary (0,1,0), so the CTA's
     ink color must be restated at matching specificity or the label washes out. */
  .nav-links > a.nav-cta {
    padding: 0.45rem 1.1rem;
    font-size: var(--text-s);
    color: var(--ember-ink);
  }

  .nav-links > a.nav-cta:hover {
    color: var(--ember-ink);
  }

  @media (max-width: 560px) {
    .nav-links > a:not(.nav-cta):not(.nav-gh) {
      display: none;
    }
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-7) 0;
    background: var(--bg-deep);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-6);
  }

  .footer-brand .brand-mark {
    color: var(--ember);
  }

  .footer-brand p {
    max-width: 34ch;
    font-size: var(--text-s);
    line-height: 1.55;
  }

  .footer-grid h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    margin: 0 0 var(--space-3);
  }

  .footer-grid nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-grid nav a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-s);
  }

  .footer-grid nav a:hover {
    color: var(--ember-bright);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
