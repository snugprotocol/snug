---
// MarketingLayout.astro — shared shell for the marketing pages (/, /download):
// dark-committed brand surface, sticky nav, footer. The docs hub has its own shell
// (Starlight); both draw from the same tokens.
import { site, siteMode } from '../config/site';
import { SECURITY_POLICY_URL, THREAT_MODEL_URL } from '@playground/legal/legalShared';
import SocialMeta from '../components/SocialMeta.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SocialMeta title={title} description={description} />
  </head>
  <body class="site">
    {
      siteMode === 'local' && (
        <div class="local-banner" role="status">
          local E2E mode — playground → {site.playground}, download → staged DMG
        </div>
      )
    }
    <header class="nav-wrap">
      <nav class="container nav" aria-label="Main">
        <a class="brand" href="/">
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" class="brand-mark">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M10 2h12a8 8 0 0 1 8 8v12a8 8 0 0 1-8 8H10a8 8 0 0 1-8-8V10a8 8 0 0 1 8-8zm6 9a5 5 0 0 0-5 5v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6a5 5 0 0 0-5-5z"
            ></path>
          </svg>
          <span class="brand-word display">snug.</span>
        </a>
        <div class="nav-links">
          <a href="/architecture/">How it works</a>
          <a href="/docs/">Docs</a>
          <a href="/docs/spec/">Spec</a>
          <a href={site.playground} target="_blank" rel="noopener">Playground</a>
          <a href={site.githubOrg} target="_blank" rel="noopener" aria-label="GitHub" class="nav-gh">
            <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
        </div>

        {/*
          The mobile disclosure. Below --nav-breakpoint the row above is hidden and this
          takes its place, carrying THE SAME destinations — the previous layout hid them
          with nothing behind it, so Docs/Spec/Playground were unreachable on a phone
          (TASK-20260826, AC4). Native <details>: no JS, no hydration, keyboard and AT
          support for free, and every link is a real page load so the panel cannot be left
          stale open. The control is the geometric mark alone (owner call 2026-08-27); its
          accessible name comes from the summary's aria-label, so the lesson behind the
          former visible "Menu" word — a bare glyph must not be nameless (2026-08-18) — is
          still satisfied. The glyph stays SVG on currentColor, never an emoji.
        */}
        <details class="nav-mobile">
          <summary aria-label="Menu">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path
                d="M2 4.5h14M2 9h14M2 13.5h14"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                fill="none"></path>
            </svg>
          </summary>
          <div class="nav-sheet">
            <a href="/architecture/">How it works</a>
            <a href="/docs/">Docs</a>
            <a href="/docs/spec/">Spec</a>
            <a href={site.playground} target="_blank" rel="noopener">Playground</a>
            <a href={site.githubOrg} target="_blank" rel="noopener">GitHub</a>
          </div>
        </details>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" class="brand-mark">
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M10 2h12a8 8 0 0 1 8 8v12a8 8 0 0 1-8 8H10a8 8 0 0 1-8-8V10a8 8 0 0 1 8-8zm6 9a5 5 0 0 0-5 5v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6a5 5 0 0 0-5-5z"
            ></path>
          </svg>
          <p class="muted">
            The Snug Protocol — an open protocol for agent-backed personal software. MIT licensed.
          </p>
        </div>
        <nav aria-label="Product">
          <h3>Product</h3>
          <a href={site.playground} target="_blank" rel="noopener">Playground</a>
          <a href="/download/">Desktop app</a>
          <a href="/docs/">Documentation</a>
        </nav>
        <nav aria-label="Protocol">
          <h3>Protocol</h3>
          <a href="/docs/spec/">Specification</a>
          <a href="/docs/spec/schemas/">Schemas</a>
          <a href="/docs/whitepaper/">Whitepaper</a>
        </nav>
        <nav aria-label="Community">
          <h3>Community</h3>
          <a href={site.githubOrg} target="_blank" rel="noopener">GitHub org</a>
          <a href={site.githubRepo} target="_blank" rel="noopener">Reference implementation</a>
          <a href={site.specRepo} target="_blank" rel="noopener">Spec repository</a>
          <a href={`mailto:${site.securityEmail}`}>{site.securityEmail}</a>
        </nav>
        <nav aria-label="Legal">
          <h3>Legal</h3>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href={THREAT_MODEL_URL} target="_blank" rel="noopener">Threat model</a>
          <a href={SECURITY_POLICY_URL} target="_blank" rel="noopener">Security policy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .local-banner {
    background: var(--warn);
    /* Was a hard-coded literal, byte-identical to --ember-ink's dark value — so this is a
       rename, not a recolour, and it now follows the light theme instead of staying dark
       ink on a light banner. Caught by AC7's no-hard-coded-colour check. */
    color: var(--ember-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: center;
    padding: 0.35rem var(--space-4);
  }

  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--bg-deep) 78%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--fg);
  }

  .brand-mark {
    color: var(--ember);
    flex-shrink: 0;
  }

  .brand-word {
    font-size: 1.45rem;
    color: var(--fg);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
  }

  .nav-links > a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-s);
    font-weight: 500;
    transition: color var(--dur-1) var(--ease-out);
  }

  .nav-links > a:hover {
    color: var(--fg);
  }

  .nav-gh {
    display: inline-flex;
  }

  /* ---------- the responsive nav pair (TASK-20260826, AC4/AC6) ----------

     One breakpoint, stated ONCE, governing two complementary rules: the desktop row
     shows at >= --nav-breakpoint, the disclosure shows at <= (bp - 0.02px). The 0.02px
     step is what keeps them mutually exclusive — a `max-width: N` / `min-width: N` pair
     both match at exactly N, which would show two navs at one width.

     Why 860px and not the old 560px: six items plus the wordmark do not fit an iPad
     portrait (768px) or a phone in landscape (~850px). Those two device classes sat in
     the band between the old breakpoint and the desktop layout and got a squeezed row —
     the exact "band between breakpoints" failure of lessons 2026-08-23.

     These rules are co-located with the base rules they override, deliberately: the
     other half of that lesson is an equal-specificity media rule placed EARLIER losing
     the cascade to a later base rule, invisible until geometry is measured. */
  .nav {
    --nav-breakpoint: 860px;
  }

  .nav-mobile {
    position: relative;
  }

  /* Icon-only since the visible "Menu" word was dropped (owner call 2026-08-27): the
     control is square rather than a text-shaped pill, and keeps the full --tap target in
     BOTH axes — a 44px-tall, 30px-wide button is still a miss on a phone. The accessible
     name now rests entirely on the summary's aria-label. */
  .nav-mobile > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    color: var(--fg);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  /* Safari renders a disclosure triangle through this pseudo-element; ::marker covers
     the rest. Both are needed — neither alone hides it everywhere. */
  .nav-mobile > summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile > summary::marker {
    content: '';
  }

  .nav-mobile > summary:hover {
    border-color: var(--ember);
  }

  .nav-mobile > summary:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 2px;
  }

  .nav-sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 0.55rem);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 14rem;
    padding: var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    /* Opaque, not the translucent nav surface: the panel overlays running text, and a
       see-through sheet let headline glyphs read through the menu items. */
    background: var(--surface-2);
    box-shadow: var(--shadow-lift);
    z-index: 30;
  }

  .nav-sheet > a {
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-s);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-s);
    font-weight: 500;
  }

  .nav-sheet > a:hover {
    background: var(--surface-2);
    color: var(--fg);
  }

  @media (min-width: 860px) {
    .nav-mobile {
      display: none;
    }
  }

  @media (max-width: 859.98px) {
    .nav-links {
      display: none;
    }
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-7) 0;
    background: var(--bg-deep);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: var(--space-6);
  }

  .footer-brand .brand-mark {
    color: var(--ember);
  }

  .footer-brand p {
    max-width: 34ch;
    font-size: var(--text-s);
    line-height: 1.55;
  }

  .footer-grid h3 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    margin: 0 0 var(--space-3);
  }

  .footer-grid nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-grid nav a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-s);
  }

  .footer-grid nav a:hover {
    color: var(--ember-bright);
  }

  @media (max-width: 1000px) {
    /* Five tracks squeeze below ~100px each here; three real columns with the brand
       spanning reads better and nothing overflows (Gate-5 review F9). */
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
