---
// AudienceSplit.astro — the two ways in for end users: the desktop app (the real
// thing — private, device-class apps) and the playground (the zero-install taste).
// Cards ARE the interaction here (each is one big link), so cards are earned.
import { site } from '../config/site';
---

<section class="section split" aria-labelledby="split-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">try it</p>
      <h2 id="split-title">Your apps. Your machine. Your file.</h2>
      <p>
        Snug runs entirely on your side of the screen — in a browser tab, or better, on your desktop
        where your smart home and your messages already live.
      </p>
    </div>

    <div class="split-grid">
      <a class="split-card split-primary" href="/download/">
        <p class="split-kicker">recommended</p>
        <h3>Snug for macOS</h3>
        <p class="split-body">
          Completely private: your file on your disk, your keys or a local model, no account. And it
          reaches what a browser can't — Philips Hue on your LAN, your personal WhatsApp, Ollama
          running beside it.
        </p>
        <ul class="split-list">
          <li>Local <code>.snug</code> file, optional passphrase encryption</li>
          <li>LAN devices, linked-device connections, native fetch</li>
          <li>Bring your own key, or no cloud at all</li>
        </ul>
        <span class="split-cta btn btn-primary">Download for macOS</span>
      </a>

      <a class="split-card" href={site.playground} target="_blank" rel="noopener">
        <p class="split-kicker">zero install</p>
        <h3>The Playground</h3>
        <p class="split-body">
          The hosted demo hub. Open a tab, describe a tiny app, watch the agent build it, run it in
          the sandbox — your file lives in the browser and exports whole whenever you want it.
        </p>
        <ul class="split-list">
          <li>Nothing to install — runs on OPFS in your browser</li>
          <li>Starters to install and remix</li>
          <li>The same protocol, end to end</li>
        </ul>
        <span class="split-cta btn btn-secondary">Open the Playground ↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .split {
    border-top: 1px solid var(--border);
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-5);
    align-items: stretch;
  }

  .split-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-l);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    text-decoration: none;
    color: var(--fg);
    transition:
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .split-card:hover {
    transform: translateY(-3px);
    border-color: var(--ember);
    box-shadow: 0 18px 48px var(--ember-glow);
  }

  .split-primary {
    background:
      radial-gradient(600px 300px at 20% -60px, var(--ember-glow), transparent 70%),
      var(--surface-2);
  }

  .split-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember-bright);
  }

  .split-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0;
  }

  .split-body {
    margin: 0;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .split-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-s);
  }

  .split-list li::before {
    content: '—';
    color: var(--ember);
    margin-right: 0.5rem;
  }

  .split-list code {
    font-family: var(--font-mono);
    color: var(--ember-bright);
  }

  .split-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 760px) {
    .split-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
