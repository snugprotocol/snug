---
// TeaserVideo.astro — the playground teaser, orientation-aware (AC2).
// The rendition choice lives in src/lib/teaser.ts (pure, unit-tested); this component
// just applies it. Muted autoplay + posters; sound is opt-in (the teaser has music).
---

<figure class="teaser">
  <div class="teaser-frame">
    <video
      id="teaser-video"
      class="teaser-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/videos/poster-landscape.jpg"
      src="/videos/teaser-landscape.mp4"
      aria-label="48-second teaser: building and running Snug apps in the playground"></video>
    <button id="teaser-sound" class="teaser-sound" type="button" aria-pressed="false">
      <span class="teaser-sound-on" hidden>sound on</span>
      <span class="teaser-sound-off">🔇 unmute</span>
    </button>
  </div>
  <figcaption class="muted">the playground, real time — talk. build. run.</figcaption>
</figure>

<script>
  import { TEASER_RENDITIONS, pickTeaserSource } from '../lib/teaser';

  const video = document.getElementById('teaser-video') as HTMLVideoElement;
  const soundToggle = document.getElementById('teaser-sound') as HTMLButtonElement;

  const rendition = TEASER_RENDITIONS[pickTeaserSource(window.innerWidth, window.innerHeight)];
  if (!video.src.endsWith(rendition.src)) {
    video.poster = rendition.poster;
    video.src = rendition.src;
  }
  video.style.aspectRatio = `${rendition.width} / ${rendition.height}`;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.controls = true;
  }

  const on = soundToggle.querySelector('.teaser-sound-on') as HTMLElement;
  const off = soundToggle.querySelector('.teaser-sound-off') as HTMLElement;
  soundToggle.addEventListener('click', () => {
    video.muted = !video.muted;
    soundToggle.setAttribute('aria-pressed', String(!video.muted));
    on.hidden = video.muted;
    off.hidden = !video.muted;
  });
</script>

<style>
  .teaser {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .teaser-frame {
    position: relative;
    width: 100%;
    border-radius: var(--radius-l);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    box-shadow:
      0 0 0 1px rgba(232, 135, 58, 0.12),
      0 24px 80px rgba(0, 0, 0, 0.55),
      0 8px 40px var(--ember-glow);
    background: var(--bg);
  }

  .teaser-video {
    display: block;
    width: 100%;
    height: auto;
  }

  .teaser-sound {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--bg-deep) 82%, transparent);
    color: var(--fg);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .teaser-sound:hover {
    border-color: var(--ember);
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }
</style>
