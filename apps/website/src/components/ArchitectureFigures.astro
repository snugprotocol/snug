        <line x1="142" y1="104" x2="212" y2="104" class="d-line" marker-end="url(#f4-ink)"></line>
        <text x="177" y="96" class="d-small" text-anchor="middle">creds</text>

        <rect x="212" y="44" width="210" height="120" rx="3" class="d-box d-box-danger"></rect>
        <text x="317" y="70" class="d-strong d-danger" text-anchor="middle">The aggregator</text>
