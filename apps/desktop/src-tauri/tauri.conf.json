{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snug",
  "version": "0.1.0",
  "identifier": "org.snugprotocol.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:41419",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snug",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["snug"],
        "name": "Snug data file",
        "description": "Snug portable data file",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Owner"
      }
    ]
  }
}
