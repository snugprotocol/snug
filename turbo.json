{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "lint": {},
    "host-mcp#test": {
      "dependsOn": [
        "build",
        "host#build"
      ]
    }
  }
}
