node_modules/
dist/
# ...except the whitepaper PDF: it IS the deliverable, and the spec repo is published
# from this committed artifact (docs/whitepaper/README.md).
!docs/whitepaper/dist/
!docs/whitepaper/dist/*.pdf
.turbo/
.next/
*.log
.env
.env.*
!.env.example
coverage/
.DS_Store

# Pre-launch strategy — never ships public (hard constraint C4). Kept local only.
internal/

# Pre-flip scrub tooling — LOCAL ONLY (owner decision 2026-08-24). These files must name
# the approved-indirection codenames in order to check for them, and the owner's call is
# that a tool built to hide a thing should not itself publish that thing. Consequence,
# recorded rather than hidden: the public repo has NO automated codename tripwire, so a
# codename reintroduced after the flip will not be caught by `pnpm test`. Run it by hand
# before any flip or release: `node scripts/check-public-scrub.mjs`. The hashed
# ancestor-identifier guard in packages/knowledge is unaffected and still ships.
scripts/check-public-scrub.mjs
scripts/check-public-scrub.test.mjs
scripts/scrub-tokens.json

# Machine-local agent settings — holds absolute paths to the source systems. Never commit.
.claude/settings.local.json
*.sqlite
!examples/**/*.sqlite
# SQLite WAL-mode sidecars. The -wal file holds recently written rows (thread
# content), so it must never be committed even though the .sqlite beside it is.
*.sqlite-wal
*.sqlite-shm

# Reference-server runtime store (SNUG_DATA_DIR). Created on first boot; the
# location depends on the working directory the server was launched from.
data/
apps/server/data/

# Playwright run artifacts (traces, screenshots, .last-run.json). Regenerated on
# every e2e run — the `gate:local` e2e leg would otherwise dirty the tree each time,
# and a stray 1.5 MB trace.zip was committed this way on 2026-08-20.
test-results/
playwright-report/

# wrangler writes per-cwd state here when run from the repo root (scripts/deploy-web.mjs).
.wrangler/

# Build output of `scripts/release-desktop.mjs` — the staged release assets (DMG,
# .app.tar.gz, .sig, latest.json). ~35 MB per release, derived from the build and
# already published as GitHub Release assets, which is the durable home for them.
# NOT ignored during the first signed release (2026-08-25), so v0.1.0's artifacts
# are in history at 36fe45c and cannot be removed without rewriting it. Ignored from
# here on so a per-release 35 MB does not repeat.
apps/desktop/release-out/
apps/whatsapp-sidecar/release-out/

# The starters package the host kit build emits from examples/ (TASK-20260905-host-kit AC14) —
# derived, rebuilt by `pnpm --filter host build:starters`; the published copy lives on npm.
apps/host/starters-pkg/
