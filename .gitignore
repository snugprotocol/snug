node_modules/
dist/
# ...except the whitepaper PDF: it IS the deliverable, and the spec repo is published
# from this committed artifact (docs/whitepaper/README.md).
!docs/whitepaper/dist/
!docs/whitepaper/dist/*.pdf
.turbo/
.next/
*.log
.env
.env.*
!.env.example
coverage/
.DS_Store

# Pre-launch strategy — never ships public (hard constraint C4). Kept local only.
internal/

# Machine-local agent settings — holds absolute paths to the source systems. Never commit.
.claude/settings.local.json
*.sqlite
!examples/**/*.sqlite
# SQLite WAL-mode sidecars. The -wal file holds recently written rows (thread
# content), so it must never be committed even though the .sqlite beside it is.
*.sqlite-wal
*.sqlite-shm

# Reference-server runtime store (SNUG_DATA_DIR). Created on first boot; the
# location depends on the working directory the server was launched from.
data/
apps/server/data/

# Playwright run artifacts (traces, screenshots, .last-run.json). Regenerated on
# every e2e run — the `gate:local` e2e leg would otherwise dirty the tree each time,
# and a stray 1.5 MB trace.zip was committed this way on 2026-08-20.
test-results/
playwright-report/

# wrangler writes per-cwd state here when run from the repo root (scripts/deploy-web.mjs).
.wrangler/
