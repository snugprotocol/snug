{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "capabilities": {
      "properties": {
        "auth": {
          "type": "boolean"
        },
        "db": {
          "type": "boolean"
        },
        "net": {
          "type": "boolean"
        },
        "openUrl": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        }
      },
      "required": [
        "streaming",
        "db",
        "auth"
      ],
      "type": "object"
    },
    "instanceId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "locale": {
      "maxLength": 32,
      "type": "string"
    },
    "protocolVersions": {
      "items": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
      },
      "type": "array"
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    },
    "type": {
      "const": "snug:host-ready",
      "type": "string"
    },
    "v": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "v",
    "type",
    "instanceId",
    "protocolVersions",
    "capabilities",
    "theme"
  ],
  "type": "object"
}
