{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "maxLength": 300,
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "opened",
        "declined",
        "refused"
      ],
      "type": "string"
    },
    "type": {
      "const": "snug:open-url-result",
      "type": "string"
    },
    "v": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "v",
    "type",
    "requestId",
    "status"
  ],
  "type": "object"
}
