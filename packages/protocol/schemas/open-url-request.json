{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "instanceId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "snug:open-url-request",
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "v": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "v",
    "type",
    "requestId",
    "instanceId",
    "url"
  ],
  "type": "object"
}
